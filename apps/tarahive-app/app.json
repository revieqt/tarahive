{
  "expo": {
    "name": "Tarahive",
    "slug": "tarahive-app",
    "scheme": "tarahiveapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0065F8"
    },
    "ios": {
      "bundleIdentifier": "com.tarahiveapp",
      "supportsTablet": true,
      "googleMobileAdsAppId": "ca-app-pub-8325794315541816~2492770428",
      "config": {
        "googleMapsApiKey": "AIzaSyDI_dL8xl7gnjcPps-CXgDJM9DtF3oZPVI"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tarahive uses your location to show your current position and routes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tarahive requires background location to track trips accurately.",
        "NSLocationAlwaysUsageDescription": "Tarahive needs background location to provide travel features.",
        "NSCameraUsageDescription": "Allow Tarahive to access your camera."
      }
    },
    "android": {
      "package": "com.tarahiveapp",
      "versionCode": 1,
      "googleMobileAdsAppId": "ca-app-pub-8325794315541816~1418527751",
      "usesCleartextTraffic": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDI_dL8xl7gnjcPps-CXgDJM9DtF3oZPVI"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "INTERNET",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8325794315541816~1418527751",
          "iosAppId": "ca-app-pub-8325794315541816~2492770428"
        }
      ],
      [
        "react-native-background-geolocation",
        {
          "backgroundPermissionRationale": {
            "title": "Allow Tarahive to access your location",
            "message": "Tarahive needs your location in the background to track trips, routes, and safety features.",
            "positiveAction": "Allow",
            "negativeAction": "Cancel"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tarahive to access your camera."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "type": "service_account",
          "webClientId": "52564336082-jb41b26p0c81n3940vcti4bo8eqvb29r.apps.googleusercontent.com",
          "iosUrlScheme": "com.googleusercontent.apps.52564336082-233pa3g5ird09jumhm4o7dbn95p9v3j3"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "06238277-5638-443b-9946-282651488366"
      }
    }
  }
}
