FROM node:20-alpine

# Install tini for proper signal handling
RUN apk add --no-cache tini

WORKDIR /usr/src/app

# Install deps first (cache optimization)
COPY package*.json ./
RUN npm install

# Copy source
COPY . .

# Fix file watching in Docker
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 5000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npm", "run", "dev"]